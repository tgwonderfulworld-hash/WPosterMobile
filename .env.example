# WPoster Mobile — environment variables.
# Copy to `.env` and fill in. Only EXPO_PUBLIC_* vars are exposed to the client
# bundle. NEVER put the Supabase service_role key or any server secret here —
# those must never ship in a mobile client.

# Supabase project URL (e.g. https://xxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase PUBLISHABLE / anon key (safe for clients; protected by RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: base URL for the WPoster REST API (Next.js / Edge functions).
# Defaults to the Supabase URL's functions endpoint when unset.
EXPO_PUBLIC_API_BASE_URL=

# Cloudflare Turnstile site key (public — same one WPoster Web uses at
# wposter.app). Supabase Auth on this project requires a captcha token for
# sign-in/sign-up/password-reset; without this, those calls fail with
# error.code === 'captcha_failed'.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
