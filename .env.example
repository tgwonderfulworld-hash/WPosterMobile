# WPoster Mobile — environment variables.
# Copy to `.env` and fill in. Only EXPO_PUBLIC_* vars are exposed to the client
# bundle. NEVER put the Supabase service_role key or any server secret here —
# those must never ship in a mobile client.

# Supabase project URL (e.g. https://xxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase PUBLISHABLE / anon key (safe for clients; protected by RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: base URL for the WPoster REST API (Next.js / Edge functions).
# Defaults to the Supabase URL's functions endpoint when unset.
EXPO_PUBLIC_API_BASE_URL=

# Cloudflare Turnstile site key (public — must be the SAME key WPoster Web
# uses at wposter.app, i.e. Web's NEXT_PUBLIC_TURNSTILE_SITE_KEY). Supabase
# Auth on this project requires a captcha token for sign-in/sign-up/
# password-reset; without this, those calls fail with
# error.code === 'captcha_failed'. Source it from the Cloudflare Turnstile
# dashboard (or Web's Vercel project env vars) — no need to touch Vercel or
# re-pull anything once it's set here; this file/`.env` is the only place
# mobile reads it from.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
